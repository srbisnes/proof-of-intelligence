# ===========================================
# Proof of Intelligence - Environment Variables
# ===========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL - Neon recommended)
DATABASE_URL=postgresql://user:password@host:5432/proof_of_intelligence?sslmode=require

# Vector Database - Qdrant
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=responses

# Embeddings (OpenAI or local)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LLM Providers
OPENAI_API_KEY=sk-...
GROK_API_KEY=xai-...
DEFAULT_LLM=openai          # openai | grok

# Hedera Hashgraph
HEDERA_NETWORK=testnet      # testnet | mainnet
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=302e...
HEDERA_TOPIC_ID=0.0.xxxxx   # HCS Topic for Proof of Intelligence

# Auth - NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_long_random_string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Wallet / Web3
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Payments (USDC on Hedera or Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
USDC_TOKEN_ID=0.0.xxxxx     # Hedera USDC token ID

# IPFS (optional - Pinata / web3.storage)
PINATA_JWT=
WEB3_STORAGE_TOKEN=

# Rate Limiting & Plans
FREE_PLAN_DAILY_QUERIES=50
PREMIUM_PLAN_PRICE_USDC=29

# Admin
ADMIN_EMAILS=you@example.com
